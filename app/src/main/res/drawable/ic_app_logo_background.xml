<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/apk/res/aapt"
    android:width="108dp"
    android:height="108dp"
    viewportWidth="108"
    viewportHeight="108">

    <!-- Deep solid backing -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:fillColor="#09051B" />

    <!-- Ambient diagonal purple gradient -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#24145F" />
                <item android:offset="0.5" android:color="#120A33" />
                <item android:offset="1.0" android:color="#050312" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central ambient purple radial glow to match the mockup lighting -->
    <path
        android:pathData="M54,54m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48"
                android:type="radial">
                <item android:offset="0.0" android:color="#5C472FC1" />
                <item android:offset="0.6" android:color="#1A2D197F" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
